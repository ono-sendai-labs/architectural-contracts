load("@gazelle//:def.bzl", "gazelle")

# The Go module lives in go/, which carries its own prefix directive; nothing at
# the repo root is a Go package.
# gazelle:prefix
# gazelle:exclude proto
# The Go sources under bazel_rules/ are hand-maintained rule-test fixtures, not
# module packages; Gazelle would rewrite their BUILD files against the wrong
# import prefix.
# gazelle:exclude bazel_rules

gazelle(name = "gazelle")

# Stable name for the arcc binary. The check rule (Step 5) and external
# consumers depend on @rules_arcc//:arcc, never on the layout of go/.
alias(
    name = "arcc",
    actual = "//go/cmd/arcc",
    visibility = ["//visibility:public"],
)
