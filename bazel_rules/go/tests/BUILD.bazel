# Negative test for self-check dependency regression: a self-component declaration
# with one declared dependency removed (//go/internal/report:report_component)
# must fail its check and report UNDECLARED_DEPENDENCY and the undeclared import path.
arcc_check_grep_test(
    name = "broken_checker_component_fails_test",
    size = "small",
    component = "//go/internal/checker:broken_checker_component",
    expected_strings = [
        "UNDECLARED_DEPENDENCY",
        "github.com/ono-sendai-labs/architectural-contracts/go/internal/report",
    ],
)

# Design §7.1 fixture 3: a member importing a package that is neither member,
# covered, nor stdlib must report UNDECLARED_DEPENDENCY naming the
# member package (example.com/aspect/member) and the undeclared package
# (example.com/aspect/memberdep).
arcc_check_grep_test(
    name = "undeclared_member_dep_fails_test",
    component = "//bazel_rules/go/tests/testdata/membercomponent:undeclared_dep_component",
    expected_strings = [
        "UNDECLARED_DEPENDENCY",
        "example.com/aspect/member",
        "example.com/aspect/memberdep",
    ],
)

# End-to-end regression hazard: uncorrected component with four member packages
# reaching three utility packages reports UNDECLARED_DEPENDENCY for all three.
# This negative test asserts that the unclassified remainder packages (util1-util3)
# are successfully reported as UNDECLARED_DEPENDENCY, preventing silent ownership.
arcc_check_grep_test(
    name = "regression_hazard_failing_test",
    component = "//bazel_rules/go/tests/testdata/hazard:failing_hazard_component",
    expected_strings = [
        "UNDECLARED_DEPENDENCY",
        "example.com/hazard/util1",
        "example.com/hazard/util2",
        "example.com/hazard/util3",
    ],
)

# End-to-end regression hazard passing repaired form: accounts for the three
# utilities and conforms.
arcc_check_test(
    name = "regression_hazard_passing_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/hazard:repaired_hazard_component",
)

# The positive check is the macro-generated
# //bazel_rules/go/tests/testdata/api:api_component.check, which runs the
# stdlib-resolving path end to end (its closure imports "strings"). This is the
# negative: a component that uses FILES without declaring it must fail its
# check. The fixture's own auto `.check` is `manual`; this drives it explicitly.
arcc_check_test(
    name = "violation_component_check_fails_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/violation:violation_component",
    expect_violation = True,
)

# Subtler negative: the authority is reachable only through an exported function
# *value* (funcvalue.Open), not a directly-called exported function. Confirms the
# capability analysis follows function values, not just direct call edges.
arcc_check_test(
    name = "funcvalue_component_check_fails_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/funcvalue:funcvalue_component",
    expect_violation = True,
)

