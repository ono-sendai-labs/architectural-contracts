# Checked-analysis execution coverage (task req 8): the same command the
# ArccCheck action runs, re-executed twice in the test sandbox against the
# action's own artifacts. The conforming component must produce a pass
# report; the violating fixture a fail report — violations are data, the
# action still succeeds (AC 2) — and both runs must be byte-identical with
# each other and with the action's outputs (AC 7). Building either test
# builds the component's analysis action and, through its declared inputs,
# the direct dependency's producer chain (AC 4).
arcc_checked_analysis_test(
    name = "checked_api_analysis_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/api:api_component",
)

arcc_checked_analysis_test(
    name = "checked_violating_analysis_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/membercomponent:undeclared_dep_component",
    expect_verdict = "fail",
)

# Tool errors still fail the action (AC 2): verdict-only mode masks
# violations, not exit 2. A malformed manifest is the smallest tool error;
# run the CLI-level behavior the action inherits directly.
sh_test(
    name = "malformed_manifest_tool_error_test",
    srcs = ["malformed_manifest_tool_error_test.sh"],
    size = "small",
    args = [
        "$(rootpath //:arcc)",
        "$(rootpath //bazel_rules/go/tests/testdata/malformed:broken.component.textproto)",
    ],
    data = [
        "//:arcc",
        "//bazel_rules/go/tests/testdata/malformed:broken.component.textproto",
    ],
)

# The private default-seam probe (task req 7): the rule Step 5's analysis
# action will mirror — it consumes the default `_stdlib_map` attribute and
# nothing else, so the seam's availability is pinned without introducing the
# analysis action itself.
default_seam_probe(name = "stdlib_map_default_seam_probe")

# The same map target under distinct target configurations (Step 4 task 06
# AC 3/6): the execution test asserts distinct, self-validating artifacts and
# deterministic bytes for identical configurations. A cgo-enabled
# configuration is rejected at analysis time (see the expect_failure analysis
# test), so there is no cgo-on target to keep out of the wildcard builds —
# AC 10 holds by construction.
darwin_arm64_stdlib_map(
    name = "stdlib_map_darwin_arm64",
    map = "//:arcc_stdlib_map",
    tags = ["manual"],
)

tagged_stdlib_map(
    name = "stdlib_map_tagged",
    map = "//:arcc_stdlib_map",
    tag = "arcc_probe_tag",
    tags = ["manual"],
)

sh_test(
    name = "stdlib_map_keys_test",
    srcs = ["stdlib_map_keys_test.sh"],
    size = "medium",
    tags = ["manual"],
    data = [
        "//:arcc",
        "//:arcc_stdlib_map",
        "//:arcc_stdlib_map_replica",
        ":stdlib_map_darwin_arm64",
        ":stdlib_map_tagged",
    ],
    args = [
        "$(rootpath //:arcc)",
        "$(rootpath //:arcc_stdlib_map)",
        "$(rootpath //:arcc_stdlib_map_replica)",
        "$(rootpath :stdlib_map_darwin_arm64)",
        "$(rootpath :stdlib_map_tagged)",
    ],
)

