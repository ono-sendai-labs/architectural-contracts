asserted_surface_test_suite(name = "asserted_surface_tests")

# AC 5 (task req 7): an explicitly requested `.check` of an asserted
# component must fail analysis with a clear no-checked-report diagnostic —
# never silently pass from the asserted surface. The analysis test asserting
# the diagnostic lives in asserted_surface_tests.bzl; the `manual` tag keeps
# this deliberately failing target out of `bazel test //...`.
arcc_check_test(
    name = "asserted_component_check_rejected_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/reportboundary/manual:manual_component",
    tags = ["manual"],
)

arcc_check_grep_test(
    name = "asserted_component_grep_rejected_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/reportboundary/manual:manual_component",
    expected_strings = ["anything"],
    tags = ["manual"],
)

# Review round 1 (shell-safety): the launcher generated for expected strings
# that are hostile as shell code — command substitution, embedded quotes and
# newlines, a leading dash, `%` signs — must keep them as data. The target is
# manual: the hostile strings are deliberately absent from the report, so the
# assertion fails when executed; the analysis test pins the launcher content.
arcc_check_grep_test(
    name = "hostile_grep_strings_launcher_probe_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/api:api_component",
    expect_status = 0,
    expected_strings = [
        "$(whoami)",
        "'; rm -rf / #",
        "a\nb",
        "-e",
        "100%s",
    ],
    tags = ["manual"],
)

arcc_check_report_golden_test(
    name = "asserted_component_golden_rejected_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/reportboundary/manual:manual_component",
    golden = "goldens/api_component.report.json",
    tags = ["manual"],
)

