# Checked-analysis execution coverage (task req 8): the same command the
# ArccCheck action runs, re-executed twice in the test sandbox against the
# action's own artifacts. The conforming component must produce a pass
# report; the violating fixture a fail report — violations are data, the
# action still succeeds (AC 2) — and both runs must be byte-identical with
# each other and with the action's outputs (AC 7). Building either test
# builds the component's analysis action and, through its declared inputs,
# the direct dependency's producer chain (AC 4).
arcc_checked_analysis_test(
    name = "checked_api_analysis_test",
    size = "small",
    component = "//bazel_rules/go/tests/testdata/api:api_component",
)

