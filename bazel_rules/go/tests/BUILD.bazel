    ],
)

# Every semantic verdict golden is guarded by the portability inventory. The
# glob makes adding a newly designated `*.verdict.golden` file automatically
# add it to the scan; shape/layout artifacts are intentionally not in this
# target. The guard also runs synthetic contamination probes so a failure
# names the forbidden content class instead of silently accepting host data.
_VERDICT_GOLDENS = glob(["goldens/*.verdict.golden"])
sh_test(
    name = "verdict_golden_portability_test",
    srcs = ["verdict_golden_portability_test.sh"],
    size = "small",
    args = ["$(rootpath %s)" % golden for golden in _VERDICT_GOLDENS],
    data = _VERDICT_GOLDENS,
)

# Package-layout shape goldens retain only distinct final contracts. The typed
# shape command validates the final export-data layout before replacing
# explicitly named host/target path values; it never compares a generated
