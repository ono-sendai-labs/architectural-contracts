load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")

# Contradiction fixtures: a member that a listed component_dep already covers
# is a conflict the rule has to reject rather than resolve. The `manual` tag
# only keeps this deliberately failing analysis out of `bazel build //...`;
# //bazel_rules/go/tests asserts on the diagnostic.
go_component(
    name = "member_covered_conflict_component",
    component_deps = ["//bazel_rules/go/tests/testdata/shared:shared_component"],
    interface = "//bazel_rules/go/tests/testdata/api",
    members = ["//bazel_rules/go/tests/testdata/shared"],
    tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Invalid policy values are rejected during component analysis rather than
# being normalized to strict or emitted into an invalid manifest.
go_component(
    name = "invalid_analysis_defeating_policy_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    analysis_defeating_policy = "maybe",
    tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)
