load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "nested",
    srcs = ["nested.go"],
    importpath = "example.com/aspect/nested",
    visibility = ["//bazel_rules:__subpackages__"],
    deps = ["//bazel_rules/go/tests/testdata/nested/child"],
)

# A component dependency may be rooted inside the consumer's package subtree;
# directory nesting no longer describes ownership. `check_tags = ["manual"]`
# keeps this analysis-only fixture's generated check out of the default test
# suite; the component itself stays on the checked path (Step 5 task 05).
go_component(
    name = "nested_component",
    component_deps = ["//bazel_rules/go/tests/testdata/nested/child:child_component"],
    interface = ":nested",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)
