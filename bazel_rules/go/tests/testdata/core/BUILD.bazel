load("@rules_go//go:def.bzl", "go_library")

# The standalone embedded package used by the aspect's fail-closed duplicate
# fixture. Its own dependency is reachable only through the embed edge of
# :core_embedded.
go_library(
    name = "core_extra",
    srcs = ["extra_impl.go"],
    importpath = "example.com/aspect/core",
    visibility = ["//visibility:private"],
    deps = ["//bazel_rules/go/tests/testdata/extradep"],
)

go_library(
    name = "core",
    srcs = [
        "core.go",
        "core_extra.go",
        "extra_impl.go",
    ],
    importpath = "example.com/aspect/core",
    visibility = ["//bazel_rules:__subpackages__"],
    deps = [
        "//bazel_rules/go/tests/testdata/extradep",
        "//bazel_rules/go/tests/testdata/lowlevel",
        "//bazel_rules/go/tests/testdata/shared",
    ],
)

# This preserves a real embed edge for the aspect tests. rules_go 0.61.1
# gives the embedder and embedded target distinct export artifacts, so the
# merge must reject the closure rather than choose one by traversal order.
go_library(
    name = "core_embedded",
    srcs = [
        "core.go",
        "core_extra.go",
    ],
    embed = [":core_extra"],
    importpath = "example.com/aspect/core",
    visibility = ["//bazel_rules:__subpackages__"],
    deps = [
        "//bazel_rules/go/tests/testdata/lowlevel",
        "//bazel_rules/go/tests/testdata/shared",
    ],
)
