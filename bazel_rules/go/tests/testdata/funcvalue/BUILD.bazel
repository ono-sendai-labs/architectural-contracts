load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "funcvalue",
    srcs = ["funcvalue.go"],
    importpath = "example.com/aspect/funcvalue",
    visibility = ["//bazel_rules:__subpackages__"],
)

# Exposes FILES authority through an exported function value but declares
# nothing, so the auto-generated `funcvalue_component.check` would fail.
# `check_tags = ["manual"]` keeps it out of `bazel test //...` while the
# component stays checked (Step 5 task 05 fixture migration);
# //bazel_rules/go/tests drives the negative assertion explicitly with
# expect_violation = True.
go_component(
    name = "funcvalue_component",
    interface = ":funcvalue",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)
