load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "splitmethod",
    srcs = [
        "api.go",
        "impl.go",
    ],
    importpath = "example.com/aspect/filelist/splitmethod",
    visibility = ["//bazel_rules:__subpackages__"],
)

go_component(
    name = "splitmethod_component",
    check_tags = ["manual"],
    interface_files = ["api.go"],
    members = [":splitmethod"],
    visibility = ["//bazel_rules:__subpackages__"],
)
