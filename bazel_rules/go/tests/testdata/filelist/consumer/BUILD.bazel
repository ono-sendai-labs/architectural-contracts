load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "consumer",
    srcs = ["consumer.go"],
    importpath = "example.com/aspect/filelist/consumer",
    visibility = ["//bazel_rules:__subpackages__"],
    deps = ["//bazel_rules/go/tests/testdata/filelist"],
)

go_component(
    name = "consumer_component",
    check_tags = ["manual"],
    component_deps = ["//bazel_rules/go/tests/testdata/filelist:filelist_component"],
    interface_files = ["consumer.go"],
    members = [":consumer"],
    visibility = ["//bazel_rules:__subpackages__"],
)
