# Tool-error fixtures for the checked-analysis execution tests (task req 8,
# AC 2): tool errors must fail the Bazel action, while violations (exit 1)
# must not.
#
# broken.component.textproto is a manifest no parser accepts, exercised
# directly by malformed_manifest_tool_error_test. broken_go_component wraps a
# Go library whose source does not parse: its ArccCheck action is expected to
# FAIL at execution when the arcc output group is requested (the just
# bazel-test gate asserts exactly that). The component stays on the checked
# path; its generated `.check` (which would fail for the same reason) is kept
# out of `bazel test //...` with `check_tags = ["manual"]`, and the unparseable
# library stays out of the wildcard default build with the `manual` tag. An
# explicit `--output_groups=+arcc` request still runs the action.
load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

exports_files(["broken.component.textproto"])

go_library(
    name = "broken",
    srcs = ["broken.go"],
    importpath = "example.com/malformed/broken",
    tags = ["manual"],
)

go_component(
    name = "broken_go_component",
    interface = ":broken",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)
