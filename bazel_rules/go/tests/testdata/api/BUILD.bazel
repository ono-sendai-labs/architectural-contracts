load("@rules_arcc//bazel_rules/go:defs.bzl", "FILES", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = ["api.go"],
    importpath = "example.com/aspect/api",
    visibility = ["//bazel_rules:__subpackages__"],
    deps = [
        "//bazel_rules/go/tests/testdata/core",
        "//bazel_rules/go/tests/testdata/shared",
    ],
)

# One component covering two membership classes:
#   covered — example.com/aspect/shared, via //shared:shared_component
#   member  — example.com/aspect/{api,core,lowlevel,extradep}
go_component(
    name = "api_component",
    component_deps = ["//bazel_rules/go/tests/testdata/shared:shared_component"],
    contract = ["contract.md"],
    declared_authority = [FILES],
    interface = ":api",
    members = [
        "//bazel_rules/go/tests/testdata/core",
        "//bazel_rules/go/tests/testdata/extradep",
        "//bazel_rules/go/tests/testdata/lowlevel",
    ],
    visibility = ["//bazel_rules:__subpackages__"],
)

# The component target stands in for its interface library: a Go rule can
# depend on it and get the same GoInfo/GoArchive.
go_test(
    name = "component_forwards_go_providers_test",
    size = "small",
    srcs = ["forwarding_test.go"],
    deps = [":api_component"],
)
