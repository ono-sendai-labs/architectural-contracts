load("@rules_arcc//bazel_rules/go:defs.bzl", "PACKAGE_SURFACE", "go_component")
load("//bazel_rules/go/tests:testing.bzl", "testing_go_component")

# Step 5 task 05 audit: these fixtures are analysis-test material, not
# unowned components. Each carries `check_tags = ["manual"]` — its generated
# check stays out of `bazel test //...` while the component itself remains a
# checked component; none of them is on the asserted path.

# The interface does not import //member. Its explicit member root must still
# contribute both itself and its member-only dependency to the closure/layout.
go_component(
    name = "member_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    # The first label is also reached transitively from :member. This overlap
    # pins import-path deduplication across independent roots.
    members = [
        "//bazel_rules/go/tests/testdata/memberdep",
        "//bazel_rules/go/tests/testdata/member",
    ],
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# The same roots in the opposite order must produce the same closure/provider
# sequence and package layout bytes.
go_component(
    name = "member_component_reversed",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    members = [
        "//bazel_rules/go/tests/testdata/member",
        "//bazel_rules/go/tests/testdata/memberdep",
    ],
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# A package-surface component has no distinguished interface. Its member roots
# must still be analyzed and its generated check is deferred until Step 7 emits
# the style and member declarations into the manifest.
go_component(
    name = "package_surface_component",
    interface_style = PACKAGE_SURFACE,
    members = [
        "//bazel_rules/go/tests/testdata/memberdep",
        "//bazel_rules/go/tests/testdata/member",
    ],
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Test target for auto-attached infra component.
testing_go_component(
    name = "auto_attached_infra_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    infra_deps = [":package_surface_component"],
    test_infra_attach = "ALWAYS",
    test_infra_patterns = ["example.com/aspect/member*"],
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# A positive CLOSURE fixture: the member root contains a package matched by
# test_infra_patterns, so attachment must emit the package-surface dependency.
testing_go_component(
    name = "closure_attached_infra_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    members = ["//bazel_rules/go/tests/testdata/core"],
    infra_deps = [":package_surface_component"],
    test_infra_attach = "CLOSURE",
    test_infra_patterns = ["example.com/aspect/core*"],
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Focused seam contract fixture: the predicate requires the interface and
# declared member to arrive together as the two root targets from M9.
testing_go_component(
    name = "root_collection_attached_infra_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    members = ["//bazel_rules/go/tests/testdata/core"],
    infra_deps = [":package_surface_component"],
    test_infra_attach = "ROOTS",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Test target for declining infra component attachment using a closure-inspecting predicate.
testing_go_component(
    name = "declining_infra_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    infra_deps = [":package_surface_component"],
    test_infra_attach = "CLOSURE",
    test_infra_patterns = ["example.com/runtime/*"],
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Test target for explicitly declining infrastructure attachment.
testing_go_component(
    name = "never_infra_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    infra_deps = [":package_surface_component"],
    test_infra_attach = "NEVER",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Test target where the same component name is authored and auto-attached;
# binding emission rejects the conflicting edge identity.
testing_go_component(
    name = "authored_wins_infra_component",
    tags = ["manual"],
    interface = "//bazel_rules/go/tests/testdata/api:api",
    component_deps = [":package_surface_component"],
    infra_deps = [":package_surface_component"],
    test_infra_attach = "ALWAYS",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Test targets for deterministic ordering of multi-entry infra registry.
testing_go_component(
    name = "multi_infra_a",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    members = [
        "//bazel_rules/go/tests/testdata/core",
        "//bazel_rules/go/tests/testdata/extradep",
    ],
    infra_deps = [
        ":package_surface_component",
        "//bazel_rules/go/tests/testdata/infra/runtime:runtime_component",
    ],
    test_infra_attach = "ALWAYS",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

testing_go_component(
    name = "multi_infra_b",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    members = [
        "//bazel_rules/go/tests/testdata/extradep",
        "//bazel_rules/go/tests/testdata/core",
    ],
    infra_deps = [
        "//bazel_rules/go/tests/testdata/infra/runtime:runtime_component",
        ":package_surface_component",
    ],
    test_infra_attach = "ALWAYS",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Design §7.1 fixture 3: a member importing a package that is neither member,
# covered, nor stdlib.
go_component(
    name = "undeclared_dep_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    members = [
        "//bazel_rules/go/tests/testdata/member",
    ],
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)
