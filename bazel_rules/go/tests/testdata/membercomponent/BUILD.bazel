load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")

# The interface does not import //member. Its explicit member root must still
# contribute both itself and its member-only dependency to the closure/layout.
go_component(
    name = "member_component",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    # The first label is also reached transitively from :member. This overlap
    # pins import-path deduplication across independent roots.
    members = [
        "//bazel_rules/go/tests/testdata/memberdep",
        "//bazel_rules/go/tests/testdata/member",
    ],
    visibility = ["//bazel_rules:__subpackages__"],
)

# The same roots in the opposite order must produce the same closure/provider
# sequence and package layout bytes.
go_component(
    name = "member_component_reversed",
    interface = "//bazel_rules/go/tests/testdata/api:api",
    members = [
        "//bazel_rules/go/tests/testdata/member",
        "//bazel_rules/go/tests/testdata/memberdep",
    ],
    visibility = ["//bazel_rules:__subpackages__"],
)
