load("@rules_arcc//bazel_rules/go:defs.bzl", "DECLARED", "PACKAGE_SURFACE", "UNKNOWN", "go_component")
load("@rules_go//go:def.bzl", "go_library")
load("//bazel_rules/go/tests:testing.bzl", "testing_go_component_direct")

go_library(
    name = "manual",
    srcs = ["manual.go"],
    importpath = "example.com/reportboundary/manual",
    visibility = ["//bazel_rules:__subpackages__"],
)

# The one genuine asserted fixture: this component is not analysed, so consumers
# that cross this boundary receive an asserted surface (provenance = "asserted",
# report = None) through the provider. Asserted surfaces are package-level (I6),
# so the component is PACKAGE_SURFACE: its complete surface is its member set.
go_component(
    name = "manual_component",
    authority = UNKNOWN,
    interface_style = PACKAGE_SURFACE,
    members = [":manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# The test-only direct-rule path bypasses the public macro validation and must
# still reject unsupported authority values in the private implementation.
testing_go_component_direct(
    name = "direct_invalid_authority_component",
    authority = "NOT_AN_AUTHORITY",
    interface = ":manual",
    tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

# Generic scheduling tags do not select a producer. This component is
# explicitly DECLARED and remains checked even though the component target and
# generated check carry the conventional Bazel `manual` scheduling tag.
go_component(
    name = "tagged_declared_component",
    authority = DECLARED,
    interface = ":manual",
    tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

