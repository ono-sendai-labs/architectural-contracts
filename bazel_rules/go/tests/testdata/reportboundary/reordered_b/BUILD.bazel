load("@rules_arcc//bazel_rules/go:defs.bzl", "PACKAGE_SURFACE", "UNKNOWN", "go_component")

# Equivalent to reordered_a, with the member labels reversed. The asserted
# surface writer must canonicalize package order independently of declaration
# order.
go_component(
    name = "reordered_component",
    authority = UNKNOWN,
    interface_style = PACKAGE_SURFACE,
    members = [
        "//bazel_rules/go/tests/testdata/shared:shared",
        "//bazel_rules/go/tests/testdata/reportboundary/manual:manual",
    ],
    visibility = ["//bazel_rules:__subpackages__"],
)

filegroup(
    name = "reordered_surface",
    srcs = [":reordered_component"],
    output_group = "arcc",
    visibility = ["//bazel_rules:__subpackages__"],
)
