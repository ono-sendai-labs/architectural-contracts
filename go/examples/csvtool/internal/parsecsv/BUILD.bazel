load("@rules_arcc//bazel_rules/go:defs.bzl", "ANALYSIS_DEFEATING_POLICY_WARN", "go_component")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "parsecsv",
    srcs = ["parsecsv.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/examples/csvtool/internal/parsecsv",
    visibility = ["//go/examples/csvtool:__subpackages__"],
)

# Shared parser utility component declaration. Its one residual
# csv.Reader.ReadAll analysis limitation is explicit and remains visible in
# the report without weakening the stdlib map or hiding the component check.
go_component(
    name = "parsecsv_component",
    interface = ":parsecsv",
    analysis_defeating_policy = ANALYSIS_DEFEATING_POLICY_WARN,
    visibility = ["//visibility:public"],
)

exports_files(["component.textproto"])
