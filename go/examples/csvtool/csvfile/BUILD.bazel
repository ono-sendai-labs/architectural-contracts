load("@rules_arcc//bazel_rules/go:defs.bzl", "FILES", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "csvfile",
    srcs = [
        "csvfile.go",
        "private.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/examples/csvtool/csvfile",
    visibility = ["//visibility:public"],
    deps = ["//go/examples/csvtool/internal/parsecsv"],
)

go_test(
    name = "csvfile_test",
    size = "small",
    srcs = ["csvfile_test.go"],
    embed = [":csvfile"],
)

# Mirrors the checked-in csvfile/component.textproto: declares FILES (it reads a
# named file via os.ReadFile) and depends on the parsecsv component. Only
# csvfile.go is the interface; private.go stays architecture-private.
go_component(
    name = "csvfile_component",
    component_deps = ["//go/examples/csvtool/internal/parsecsv:parsecsv_component"],
    declared_authority = [FILES],
    interface = ":csvfile",
    visibility = ["//visibility:public"],
)

# The checked-in manifest, referenced by //go/examples/csvtool/app's parity test.
exports_files(["component.textproto"])
