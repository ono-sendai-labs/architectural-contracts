load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "toprow",
    srcs = ["toprow.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/examples/csvtool/toprow",
    visibility = ["//visibility:public"],
    deps = ["//go/examples/csvtool/internal/parsecsv"],
)

go_test(
    name = "toprow_test",
    size = "small",
    srcs = ["toprow_test.go"],
    embed = [":toprow"],
)

# Mirrors the checked-in toprow/component.textproto: no declared authority, and
# parsecsv absorbed as an implementation detail. Its `.check` conforms because
# parsecsv touches no filesystem.
go_component(
    name = "toprow_component",
    absorbed_deps = ["//go/examples/csvtool/internal/parsecsv"],
    interface = ":toprow",
    visibility = ["//visibility:public"],
)

# The checked-in manifest, referenced by //go/examples/csvtool/app's parity test.
exports_files(["component.textproto"])
