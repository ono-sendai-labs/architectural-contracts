name: "protobuf-runtime"
# The generated protobuf runtime is an adopted package-level boundary. Its
# source is not an architectural member of each consumer; the native staging
# harness supplies the sibling surface, while Bazel's authority: UNKNOWN
# component emits the equivalent asserted surface without an analysis action.
interface_style: INTERFACE_STYLE_PACKAGE_SURFACE
members: "google.golang.org/protobuf/encoding/protojson"
members: "google.golang.org/protobuf/encoding/prototext"
members: "google.golang.org/protobuf/encoding/protowire"
members: "google.golang.org/protobuf/internal/descfmt"
members: "google.golang.org/protobuf/internal/descopts"
members: "google.golang.org/protobuf/internal/detrand"
members: "google.golang.org/protobuf/internal/editiondefaults"
members: "google.golang.org/protobuf/internal/encoding/defval"
members: "google.golang.org/protobuf/internal/encoding/json"
members: "google.golang.org/protobuf/internal/encoding/messageset"
members: "google.golang.org/protobuf/internal/encoding/tag"
members: "google.golang.org/protobuf/internal/encoding/text"
members: "google.golang.org/protobuf/internal/errors"
members: "google.golang.org/protobuf/internal/filedesc"
members: "google.golang.org/protobuf/internal/filetype"
members: "google.golang.org/protobuf/internal/flags"
members: "google.golang.org/protobuf/internal/genid"
members: "google.golang.org/protobuf/internal/impl"
members: "google.golang.org/protobuf/internal/order"
members: "google.golang.org/protobuf/internal/pragma"
members: "google.golang.org/protobuf/internal/protolazy"
members: "google.golang.org/protobuf/internal/set"
members: "google.golang.org/protobuf/internal/strs"
members: "google.golang.org/protobuf/internal/version"
members: "google.golang.org/protobuf/proto"
members: "google.golang.org/protobuf/reflect/protoreflect"
members: "google.golang.org/protobuf/reflect/protoregistry"
members: "google.golang.org/protobuf/runtime/protoiface"
members: "google.golang.org/protobuf/runtime/protoimpl"
authority: UNKNOWN
