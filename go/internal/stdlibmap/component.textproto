name: "stdlibmap"
# Generation shell component: the SDK enumeration oracle, the go/types
# inventory, the Capslock-backed generator, and the native SDK-keyed cache.
# Its retained x/tools, x/mod, and x/sync closure is owned by the explicit
# x-tools package-surface boundary below rather than duplicated as members.
# Declared-interface style: its exported API (stdlibmap.go, sdkkey.go) produces
# and reads the total standard-library authority map consumed by the CLI. Host
# toolchain subprocesses and filesystem probes/writes are confined to the
# stdlibmap-hosttoolchain and atomicfile sub-components, leaving stdlibmap
# itself authority-free. It is deliberately not declared as a go_component
# under Bazel — like capslockadapter, its closure (golang.org/x/tools/go/
# packages) pulls in cgo-built packages and component.bzl fails closed on cgo
# closures; native coverage is via the FR10 contract and the Bazel
# arcc_stdlib_map rule consumes its artifacts rather than running this
# component inside a checked action.
interface_files: "sdkkey.go"
interface_files: "stdlibmap.go"
members: "github.com/ono-sendai-labs/architectural-contracts/go/internal/stdlibmap"
component_dependencies {
  name: "artifactio"
  manifest: "../artifactio/component.textproto"
}
component_dependencies {
  name: "atomicfile"
  manifest: "../atomicfile/component.textproto"
}
component_dependencies {
  name: "capslockadapter"
  manifest: "../capslockadapter/component.textproto"
}
component_dependencies {
  name: "capslocksymbol"
  manifest: "../capslocksymbol/component.textproto"
}
component_dependencies {
  name: "schema"
  manifest: "../schema/component.textproto"
}
component_dependencies {
  name: "schema-gen"
  manifest: "../schema/gen/component.textproto"
}
component_dependencies {
  name: "stdlibauthority"
  manifest: "../stdlibauthority/component.textproto"
}
component_dependencies {
  name: "stdlibmap-hosttoolchain"
  manifest: "internal/hosttoolchain/component.textproto"
}
component_dependencies {
  name: "symbol"
  manifest: "../symbol/component.textproto"
}
component_dependencies {
  name: "x-tools"
  manifest: "../xtools/component.textproto"
}
component_dependencies {
  name: "hostpolicy"
  manifest: "../hostpolicy/component.textproto"
}
component_dependencies {
  name: "packagelayout"
  manifest: "../packagelayout/component.textproto"
}
