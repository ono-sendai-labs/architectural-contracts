load("@rules_go//go:def.bzl", "go_library", "go_test")

# stdlibmap is deliberately not declared as a go_component under Bazel: like
# capslockadapter, its closure (golang.org/x/tools/go/packages) pulls in
# cgo-built packages, and component.bzl fails closed on cgo closures. Its
# manifest retains native coverage via the FR10 contract above; when the map
# generator lands (step04 task 3) the Bazel arcc_stdlib_map rule consumes its
# artifacts rather than running this component inside a checked action.
go_library(
    name = "stdlibmap",
    srcs = [
        "cache.go",
        "explicit.go",
        "generate.go",
        "layoutloader.go",
        "inventory.go",
        "nativeloader.go",
        "sdkkey.go",
        "stdlibmap.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/stdlibmap",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/artifactio",
        "//go/internal/capslockadapter",
        "//go/internal/hostpolicy",
        "//go/internal/packagelayout",
        "//go/internal/schema",
        "//go/internal/schema/gen",
        "//go/internal/stdlibauthority",
        "//go/internal/symbol",
        "@org_golang_x_tools//go/packages",
    ],
)

go_test(
    name = "stdlibmap_test",
    size = "small",
    srcs = [
        "cache_test.go",
        "explicit_test.go",
        "generate_test.go",
        "inventory_test.go",
        "layoutloader_test.go",
        "sdkkey_test.go",
        "stdlibmap_test.go",
    ],
    embed = [":stdlibmap"],
    deps = [
        "//go/internal/artifactio",
        "//go/internal/capslockadapter",
        "//go/internal/packagelayout",
        "//go/internal/schema/gen",
        "//go/internal/stdlibauthority",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_tools//go/packages",
    ],
)
