load("@rules_go//go:def.bzl", "go_library")

# capslockadapter is deliberately not declared as a go_component under Bazel:
# its closure includes golang.org/x/sys/unix (via capslock) which uses cgo, and
# component.bzl fails closed on cgo closures. It retains native coverage via
# `just selfcheck`.
go_library(
    name = "capslockadapter",
    srcs = ["capslockadapter.go", "generation.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/capslockadapter",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/capanalyzer",
        "//go/internal/packagelayout",
        "@com_github_google_capslock//analyzer",
        "@com_github_google_capslock//interesting",
        "@org_golang_x_tools//go/packages",
    ],
)
