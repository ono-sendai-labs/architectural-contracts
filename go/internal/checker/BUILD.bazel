load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "checker",
    srcs = ["aggregate.go", "boundary.go", "checker.go", "classify.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/checker",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/capanalyzer",
        "//go/internal/facts",
        "//go/internal/manifest",
        "//go/internal/report",
        "//go/internal/stdlibauthority",
        "//go/internal/symbol",
    ],
)

go_test(
    name = "checker_test",
    size = "small",
    srcs = ["aggregate_test.go", "boundary_test.go", "checker_test.go", "classify_test.go", "unused_authority_test.go"],
    deps = [
        ":checker",
        "//go/internal/artifactio",
        "//go/internal/capanalyzer",
        "//go/internal/facts",
        "//go/internal/manifest",
        "//go/internal/report",
        "//go/internal/stdlibauthority",
        "//go/internal/symbol",
    ],
)

# Mirrors the checked-in checker/component.textproto: authority-free and depends
# on capanalyzer, facts, manifest, report, stdlibauthority, and symbol components.
go_component(
    name = "checker_component",
    component_deps = [
        "//go/internal/capanalyzer:capanalyzer_component",
        "//go/internal/facts:facts_component",
        "//go/internal/manifest:manifest_component",
        "//go/internal/report:report_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/symbol:symbol_component",
    ],
    interface = ":checker",
    visibility = ["//go:__subpackages__"],
)

# Deliberately broken fixture component mirroring checker_component with
# //go/internal/report:report_component omitted from component_deps.
# Its generated `.check` deliberately fails (the missing edge is the
# point); `check_tags = ["manual"]` keeps it out of `bazel test //...`
# while the component itself stays checked.
#
# What keeps this honest: it must stay a copy of checker_component minus exactly
# one edge (report_component), so that if checker's real dependency set changes,
# this fixture is updated rather than left describing a component that no
# longer exists.
go_component(
    name = "broken_checker_component",
    component_deps = [
        "//go/internal/capanalyzer:capanalyzer_component",
        "//go/internal/facts:facts_component",
        "//go/internal/manifest:manifest_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/symbol:symbol_component",
    ],
    interface = ":checker",
    check_tags = ["manual"],
    visibility = ["//bazel_rules:__subpackages__"],
)

exports_files(["component.textproto"])
