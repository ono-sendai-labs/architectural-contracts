load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "artifactio",
    srcs = [
        "artifactio.go",
        "digest.go",
        "report.go",
    "stdlibmap.go",
    "stdlibmapreader.go",
    "surface.go",
    "surfacepaths.go",
    "write.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/artifactio",
    # Like hostpolicy: the go_component rule resolves member labels from the
    # //bazel_rules rule packages, so visibility must include those too.
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "//go/internal/report",
        "//go/internal/schema",
        "//go/internal/schema/gen",
        "//go/internal/symbol",
        "//go/internal/stdlibauthority",
        "//go/internal/surface",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "artifactio_test",
    size = "small",
    srcs = [
        "artifactio_test.go",
        "decode_test.go",
        "rework_test.go",
        "report_test.go",
        "stdlibmap_test.go",
        "stdlibmapreader_test.go",
        "surfacepath_test.go",
        "write_test.go",
    ],
    embed = [":artifactio"],
    deps = [
        "//go/internal/schema/gen",
        "//go/internal/symbol",
        "//go/internal/stdlibauthority",
        "//go/internal/surface",
        "//go/internal/manifest",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# Mirrors the checked-in artifactio/component.textproto: shell component with
# the protobuf runtime it drives directly as members; the schema and symbol
# packages are consumed through declared component dependencies on their
# single-owner components.
# EXEMPT (Step 6 task 05 AC8b; TODO(Step 7 protobuf-runtime PACKAGE_SURFACE
# migration): the transitional protobuf-runtime members reference UNANALYZED
# stdlib records — 89 AnalysisDefeating sites (unsafe.Pointer x52,
# (sync.Once).Do x17, sort.Slice x11, (sync.Pool).Get x3, io.WriteString x2,
# io.ReadAll x2, compress/gzip.NewReader x1, errors.As x1) plus one
# OPERATING_SYSTEM finding (os.Stderr) — so the checked .check test would
# fail its pass assertion. check_tags=["manual"] (the Step 5 task 05 seam)
# keeps the analysis action built by `bazel build //...` while exempting the
# verdict test; Step 7 removes the exemption.
go_component(
    name = "artifactio_component",
    interface_style = "PACKAGE_SURFACE",
    check_tags = ["manual"],
    component_deps = [
        "//go/internal/report:report_component",
        "//go/internal/schema:schema_component",
        "//go/internal/symbol:symbol_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/surface:surface_component",
    ],
    declared_authority = [
        "FILES",
        "MODIFY_SYSTEM_STATE",
        "READ_SYSTEM_STATE",
        "REFLECT",
        "RUNTIME",
        "SYSTEM_CALLS",
        "UNSAFE_POINTER",
    ],
    members = [
        "//go/internal/artifactio",
        "@org_golang_google_protobuf//encoding/protojson:protojson",
        "@org_golang_google_protobuf//encoding/prototext:prototext",
        "@org_golang_google_protobuf//encoding/protowire:protowire",
        "@org_golang_google_protobuf//internal/descfmt:descfmt",
        "@org_golang_google_protobuf//internal/descopts:descopts",
        "@org_golang_google_protobuf//internal/detrand:detrand",
        "@org_golang_google_protobuf//internal/editiondefaults:editiondefaults",
        "@org_golang_google_protobuf//internal/encoding/defval:defval",
        "@org_golang_google_protobuf//internal/encoding/json:json",
        "@org_golang_google_protobuf//internal/encoding/messageset:messageset",
        "@org_golang_google_protobuf//internal/encoding/tag:tag",
        "@org_golang_google_protobuf//internal/encoding/text:text",
        "@org_golang_google_protobuf//internal/errors:errors",
        "@org_golang_google_protobuf//internal/filedesc:filedesc",
        "@org_golang_google_protobuf//internal/filetype:filetype",
        "@org_golang_google_protobuf//internal/flags:flags",
        "@org_golang_google_protobuf//internal/genid:genid",
        "@org_golang_google_protobuf//internal/impl:impl",
        "@org_golang_google_protobuf//internal/order:order",
        "@org_golang_google_protobuf//internal/pragma:pragma",
        "@org_golang_google_protobuf//internal/protolazy:protolazy",
        "@org_golang_google_protobuf//internal/set:set",
        "@org_golang_google_protobuf//internal/strs:strs",
        "@org_golang_google_protobuf//internal/version:version",
        "@org_golang_google_protobuf//proto:proto",
        "@org_golang_google_protobuf//reflect/protoreflect:protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry:protoregistry",
        "@org_golang_google_protobuf//runtime/protoiface:protoiface",
        "@org_golang_google_protobuf//runtime/protoimpl:protoimpl",
    ],
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
