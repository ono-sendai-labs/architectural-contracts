load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "artifactio",
    srcs = [
        "artifactio.go",
        "digest.go",
        "report.go",
    "stdlibmap.go",
    "stdlibmapreader.go",
    "surface.go",
    "surfacepaths.go",
    "write.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/artifactio",
    # Like hostpolicy: the go_component rule resolves member labels from the
    # //bazel_rules rule packages, so visibility must include those too.
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "//go/internal/report",
        "//go/internal/schema",
        "//go/internal/schema/gen",
        "//go/internal/symbol",
        "//go/internal/stdlibauthority",
        "//go/internal/surface",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "artifactio_test",
    size = "small",
    srcs = [
        "artifactio_test.go",
        "decode_test.go",
        "rework_test.go",
        "report_test.go",
        "stdlibmap_test.go",
        "stdlibmapreader_test.go",
        "surfacepath_test.go",
        "write_test.go",
    ],
    embed = [":artifactio"],
    deps = [
        "//go/internal/schema/gen",
        "//go/internal/symbol",
        "//go/internal/stdlibauthority",
        "//go/internal/surface",
        "//go/internal/manifest",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# Mirrors the checked-in artifactio/component.textproto: shell component with
# the foreign protobuf runtime behind its shared package-surface dependency;
# schema and symbol remain declared component dependencies.
# EXEMPT (Step 6 task 05 AC8b; TODO(Step 7 residual-UNANALYZED decision):
# the component's own byte-bounded artifact reader still has one honest
# UNANALYZED io.ReadAll site, so its checked .check would fail its pass
# assertion. check_tags=["manual"] keeps the transitional verdict test out of
# the gate without weakening the emitted report.
go_component(
    name = "artifactio_component",
    interface_style = "PACKAGE_SURFACE",
    check_tags = ["manual"],
    component_deps = [
        "//go/internal/report:report_component",
        "//go/internal/schema:schema_component",
        "//go/internal/symbol:symbol_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/surface:surface_component",
        "//go/internal/protobufruntime:protobuf-runtime",
    ],
    declared_authority = [
        "FILES",
        "MODIFY_SYSTEM_STATE",
        "READ_SYSTEM_STATE",
        "REFLECT",
        "RUNTIME",
        "SYSTEM_CALLS",
        "UNSAFE_POINTER",
    ],
    members = ["//go/internal/artifactio"],
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
