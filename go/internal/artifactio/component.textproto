name: "artifactio"
# Shell component: owns its own implementation and the protobuf runtime
# closure it drives directly. The manifest model, generated schema types, and
# symbol grammar are consumed inward through declared component dependencies;
# their single owners are the manifest and symbol components.
interface_style: INTERFACE_STYLE_PACKAGE_SURFACE
members: "github.com/ono-sendai-labs/architectural-contracts/go/internal/artifactio"
