name: "artifactio"
# Shell component: owns its implementation and consumes the generated schema,
# capability vocabulary, symbol grammar, and foreign protobuf runtime through
# their single-owner package-surface dependencies.
interface_style: INTERFACE_STYLE_PACKAGE_SURFACE
component_dependencies {
  name: "report"
  manifest: "../report/component.textproto"
}
component_dependencies {
  name: "schema"
  manifest: "../schema/component.textproto"
}
component_dependencies {
  name: "stdlibauthority"
  manifest: "../stdlibauthority/component.textproto"
}
component_dependencies {
  name: "surface"
  manifest: "../surface/component.textproto"
}
component_dependencies {
  name: "symbol"
  manifest: "../symbol/component.textproto"
}
component_dependencies {
  name: "protobuf-runtime"
  manifest: "../protobufruntime/component.textproto"
}
members: "github.com/ono-sendai-labs/architectural-contracts/go/internal/artifactio"
declared_authority: "FILES"
declared_authority: "REFLECT"
declared_authority: "UNSAFE_POINTER"
