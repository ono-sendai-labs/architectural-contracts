load(
    "@rules_arcc//bazel_rules/go:defs.bzl",
    "READ_SYSTEM_STATE",
    "RUNTIME",
    "go_component",
)
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "goanalysis",
    srcs = [
        "defeatscan.go",
        "goanalysis.go",
        "refscan.go",
        "scanobserver.go",
        "surface_resolver.go",
        "surfaceinputs.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/goanalysis",
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "//go/internal/artifactio",
        "//go/internal/facts",
        "//go/internal/goanalysis/internal/hostfs",
        "//go/internal/hostpolicy",
        "//go/internal/manifest",
        "//go/internal/packagelayout",
        "//go/internal/reportio",
        "//go/internal/schema/gen",
        "//go/internal/stdlibauthority",
        "//go/internal/surface",
        "//go/internal/symbol",
        "@org_golang_x_tools//go/gcexportdata",
        "@org_golang_x_tools//go/packages",
    ],
)

# Mirrors the checked-in goanalysis/component.textproto: depends on the pure
# facts/manifest/symbol contracts plus the artifactio, schema,
# stdlibauthority, surface, x-tools, report, hostpolicy, packagelayout, and
# hostfs component boundaries; retains local member ownership only of
# goanalysis; declares the two capabilities exercised by its member code. The
# foreign x/tools implementation and the in-tree package-layout loader are
# explicit package-surface boundaries rather than duplicated member source, so
# this component's own analysis does not charge either dependency's internals
# to it.
go_component(
    name = "goanalysis_component",
    component_deps = [
        "//go/internal/artifactio:artifactio_component",
        "//go/internal/facts:facts_component",
        "//go/internal/goanalysis/internal/hostfs:hostfs_component",
        "//go/internal/manifest:manifest_component",
        "//go/internal/reportio:reportio_component",
        "//go/internal/schema/gen:schema_gen_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/surface:surface_component",
        "//go/internal/symbol:symbol_component",
        "//go/internal/xtools:x-tools",
        "//go/internal/hostpolicy:hostpolicy_component",
        "//go/internal/packagelayout:packagelayout_component",
    ],
    declared_authority = [
        # READ_SYSTEM_STATE and RUNTIME are the go/build and runtime import charges per F12, removed in Step 11.
        READ_SYSTEM_STATE,
        RUNTIME,
    ],
    interface_files = [
        "defeatscan.go",
        "goanalysis.go",
        "surface_resolver.go",
        "surfaceinputs.go",
    ],
    members = [":goanalysis"],
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
