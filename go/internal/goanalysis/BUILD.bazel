load(
    "@rules_arcc//bazel_rules/go:defs.bzl",
    "FILES",
    "READ_SYSTEM_STATE",
    "RUNTIME",
    "go_component",
)
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "goanalysis",
    srcs = [
        "defeatscan.go",
        "goanalysis.go",
        "refscan.go",
        "scanobserver.go",
        "surface_resolver.go",
        "surfaceinputs.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/goanalysis",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/artifactio",
        "//go/internal/facts",
        "//go/internal/hostpolicy",
        "//go/internal/manifest",
        "//go/internal/packagelayout",
        "//go/internal/schema/gen",
        "//go/internal/stdlibauthority",
        "//go/internal/surface",
        "//go/internal/symbol",
        "@org_golang_x_tools//go/gcexportdata:gcexportdata",
        "@org_golang_x_tools//go/packages",
    ],
)

# Mirrors the checked-in goanalysis/component.textproto: depends on the pure
# facts/manifest/symbol contracts plus the artifactio, schema,
# stdlibauthority, surface, x-tools, report, hostpolicy, and packagelayout
# component boundaries; retains local member ownership only of goanalysis;
# declares the three capabilities exercised by its member code. The foreign
# x/tools implementation and the in-tree
# package-layout loader are explicit package-surface boundaries rather than
# duplicated member source, so this component's own analysis does not charge
# either dependency's internals to it.
go_component(
    name = "goanalysis_component",
    component_deps = [
        "//go/internal/artifactio:artifactio_component",
        "//go/internal/facts:facts_component",
        "//go/internal/manifest:manifest_component",
        "//go/internal/schema:schema_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/surface:surface_component",
        "//go/internal/symbol:symbol_component",
        "//go/internal/xtools:x-tools",
        "//go/internal/report:report_component",
        "//go/internal/hostpolicy:hostpolicy_component",
        "//go/internal/packagelayout:packagelayout_component",
    ],
    declared_authority = [
        FILES,
        READ_SYSTEM_STATE,
        RUNTIME,
    ],
    interface = ":goanalysis",
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
