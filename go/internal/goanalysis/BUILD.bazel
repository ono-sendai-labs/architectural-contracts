load(
    "@rules_arcc//bazel_rules/go:defs.bzl",
    "ARBITRARY_EXECUTION",
    "EXEC",
    "FILES",
    "MODIFY_SYSTEM_STATE",
    "OPERATING_SYSTEM",
    "READ_SYSTEM_STATE",
    "REFLECT",
    "UNSAFE_POINTER",
    "go_component",
)
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "goanalysis",
    srcs = [
        "defeatscan.go",
        "goanalysis.go",
        "refscan.go",
        "surface_resolver.go",
        "surfaceinputs.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/goanalysis",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/artifactio",
        "//go/internal/facts",
        "//go/internal/hostpolicy",
        "//go/internal/manifest",
        "//go/internal/packagelayout",
        "//go/internal/schema/gen",
        "//go/internal/stdlibauthority",
        "//go/internal/surface",
        "//go/internal/symbol",
        "@org_golang_x_tools//go/packages",
    ],
)

# Mirrors the checked-in goanalysis/component.textproto: depends on the pure
# facts/manifest/symbol contracts plus the artifactio, schema,
# stdlibauthority, and surface shells used by the additive persisted-surface
# consumer; owns //go/internal/hostpolicy, //go/internal/packagelayout, and
# the x/tools package-surface dependency; declares 8 authorities. The foreign
# x/tools implementation is one adopted boundary rather than member source,
# so this component's own analysis does not charge x/tools internals to it.
# EXEMPT (Step 6 task 05 AC8b; TODO(Step 7 residual-UNANALYZED decision):
# goanalysis still owns the layout-driver implementation, whose native-only
# parser/build-context operations produce honest AnalysisDefeating records.
# `check_tags=["manual"]` keeps that transitional native selfcheck out of the
# Bazel verdict gate without weakening the analysis action or its report.
go_component(
    name = "goanalysis_component",
    check_tags = ["manual"],
    members = [
        "//go/internal/packagelayout",
    ],
    component_deps = [
        "//go/internal/artifactio:artifactio_component",
        "//go/internal/facts:facts_component",
        "//go/internal/manifest:manifest_component",
        "//go/internal/schema:schema_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/surface:surface_component",
        "//go/internal/symbol:symbol_component",
        "//go/internal/xtools:x-tools",
        "//go/internal/report:report_component",
        "//go/internal/hostpolicy:hostpolicy_component",
    ],
    declared_authority = [
        ARBITRARY_EXECUTION,
        FILES,
        EXEC,
        READ_SYSTEM_STATE,
        OPERATING_SYSTEM,
        REFLECT,
        UNSAFE_POINTER,
        MODIFY_SYSTEM_STATE,
    ],
    interface = ":goanalysis",
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
