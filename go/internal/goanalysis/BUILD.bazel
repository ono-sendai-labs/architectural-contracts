load(
    "@rules_arcc//bazel_rules/go:defs.bzl",
    "ARBITRARY_EXECUTION",
    "EXEC",
    "FILES",
    "MODIFY_SYSTEM_STATE",
    "OPERATING_SYSTEM",
    "READ_SYSTEM_STATE",
    "REFLECT",
    "UNSAFE_POINTER",
    "go_component",
)
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "goanalysis",
    srcs = ["defeatscan.go", "goanalysis.go", "surfaceinputs.go", "refscan.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/goanalysis",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/facts",
        "//go/internal/hostpolicy",
        "//go/internal/manifest",
        "//go/internal/packagelayout",
        "//go/internal/symbol",
        "@org_golang_x_tools//go/packages",
    ],
)

# Mirrors the checked-in goanalysis/component.textproto: depends on
# facts, manifest, and symbol components; owns //go/internal/hostpolicy,
# //go/internal/packagelayout, and the x/tools closure as declared members;
# declares 8 authorities.
# hostpolicy, packagelayout, and the x/tools closure are declared members:
# code the component calls into is owned member code whose authority is charged
# to this component's declared_authority.
go_component(
    name = "goanalysis_component",
    members = [
        "//go/internal/hostpolicy",
        "//go/internal/packagelayout",
        "@org_golang_x_mod//semver:semver",
        "@org_golang_x_sync//errgroup:errgroup",
        "@org_golang_x_tools//go/ast/astutil:astutil",
        "@org_golang_x_tools//go/ast/edge:edge",
        "@org_golang_x_tools//go/ast/inspector:inspector",
        "@org_golang_x_tools//go/buildutil:buildutil",
        "@org_golang_x_tools//go/gcexportdata:gcexportdata",
        "@org_golang_x_tools//go/internal/cgo:cgo",
        "@org_golang_x_tools//go/loader:loader",
        "@org_golang_x_tools//go/packages:packages",
        "@org_golang_x_tools//go/types/objectpath:objectpath",
        "@org_golang_x_tools//go/types/typeutil:typeutil",
        "@org_golang_x_tools//internal/aliases:aliases",
        "@org_golang_x_tools//internal/event:event",
        "@org_golang_x_tools//internal/event/core:core",
        "@org_golang_x_tools//internal/event/keys:keys",
        "@org_golang_x_tools//internal/event/label:label",
        "@org_golang_x_tools//internal/gcimporter:gcimporter",
        "@org_golang_x_tools//internal/gocommand:gocommand",
        "@org_golang_x_tools//internal/packagesinternal:packagesinternal",
        "@org_golang_x_tools//internal/pkgbits:pkgbits",
        "@org_golang_x_tools//internal/stdlib:stdlib",
        "@org_golang_x_tools//internal/typeparams:typeparams",
        "@org_golang_x_tools//internal/typesinternal:typesinternal",
        "@org_golang_x_tools//internal/versions:versions",
    ],
    component_deps = [
        "//go/internal/facts:facts_component",
        "//go/internal/manifest:manifest_component",
        "//go/internal/symbol:symbol_component",
    ],
    declared_authority = [
        ARBITRARY_EXECUTION,
        FILES,
        EXEC,
        READ_SYSTEM_STATE,
        OPERATING_SYSTEM,
        REFLECT,
        UNSAFE_POINTER,
        MODIFY_SYSTEM_STATE,
    ],
    interface = ":goanalysis",
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
