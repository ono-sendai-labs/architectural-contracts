load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "report",
    srcs = ["report.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/report",
    visibility = ["//go:__subpackages__"],
)

go_test(
    name = "report_test",
    size = "small",
    srcs = ["report_test.go"],
    deps = [":report"],
)

# Mirrors the checked-in report/component.textproto.
go_component(
    name = "report_component",
    interface = ":report",
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
