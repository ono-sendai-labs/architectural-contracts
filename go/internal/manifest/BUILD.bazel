load(
    "@rules_arcc//bazel_rules/go:defs.bzl",
    "READ_SYSTEM_STATE",
    "REFLECT",
    "RUNTIME",
    "SYSTEM_CALLS",
    "UNSAFE_POINTER",
    "go_component",
)
load("@rules_go//go:def.bzl", "go_library", "go_test")

# keep: //bazel_rules/tests:authority_sync_test reads the known capability
# taxonomy out of the source to compare it with the Starlark authority
# taxonomy; the set lives in the schema component
# (//go/internal/schema:capabilities.go).
exports_files([
    "manifest.go",
    "component.textproto",
])

go_library(
    name = "manifest",
    srcs = [
        "authority.go",
        "manifest.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/manifest",
    # Like hostpolicy: the go_component rule resolves member labels from the
    # //bazel_rules rule packages, so visibility must include those too.
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "//go/internal/schema",
        "//go/internal/schema/gen",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)

go_test(
    name = "manifest_test",
    size = "small",
    srcs = [
        "authority_test.go",
        "manifest_test.go",
        "schema_test.go",
    ],
    # keep: TestSelfHostingManifests walks the checked-in source tree by
    # relative path (sibling manifests, their interface files and imports), so
    # it needs the working copy rather than a runfiles tree. It runs under
    # `just ci`'s `go test ./...`; `manual` keeps it out of `bazel test //...`.
    tags = ["manual"],
    deps = [":manifest"],
)

# Mirrors the checked-in manifest/component.textproto. The generated schema
# package is owned by the schema component and consumed through a declared
# component dependency.
# The foreign protobuf runtime is consumed through the shared package-surface
# component, so its source is not charged to this component's own contract.
# EXEMPT (Step 6 task 05 AC8b; TODO(Step 7 residual-UNANALYZED decision):
# the component's own manifest reader still has one honest UNANALYZED
# io.ReadAll site, so its checked .check would fail its pass assertion. The
# foreign protobuf runtime is now behind the shared package-surface component.
# check_tags=["manual"] keeps the transitional verdict test out of the gate
# without weakening the emitted report.
go_component(
    name = "manifest_component",
    check_tags = ["manual"],
    component_deps = [
        "//go/internal/protobufruntime:protobuf-runtime",
        "//go/internal/schema:schema_component",
    ],
    members = [],
    declared_authority = [
        READ_SYSTEM_STATE,
        REFLECT,
        RUNTIME,
        SYSTEM_CALLS,
        UNSAFE_POINTER,
    ],
    interface = ":manifest",
    visibility = ["//go:__subpackages__"],
)
