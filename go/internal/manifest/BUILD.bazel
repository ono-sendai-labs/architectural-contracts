load(
    "@rules_arcc//bazel_rules/go:defs.bzl",
    "READ_SYSTEM_STATE",
    "REFLECT",
    "RUNTIME",
    "SYSTEM_CALLS",
    "UNSAFE_POINTER",
    "go_component",
)
load("@rules_go//go:def.bzl", "go_library", "go_test")

# keep: //bazel_rules/tests:authority_sync_test reads the known capability
# taxonomy out of the source to compare it with the Starlark authority
# taxonomy; the set lives in the schema component
# (//go/internal/schema:capabilities.go).
exports_files([
    "manifest.go",
    "component.textproto",
])

go_library(
    name = "manifest",
    srcs = [
        "authority.go",
        "manifest.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/manifest",
    # Like hostpolicy: the go_component rule resolves member labels from the
    # //bazel_rules rule packages, so visibility must include those too.
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "//go/internal/schema",
        "//go/internal/schema/gen",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)

go_test(
    name = "manifest_test",
    size = "small",
    srcs = [
        "authority_test.go",
        "manifest_test.go",
        "schema_test.go",
    ],
    # keep: TestSelfHostingManifests walks the checked-in source tree by
    # relative path (sibling manifests, their interface files and imports), so
    # it needs the working copy rather than a runfiles tree. It runs under
    # `just ci`'s `go test ./...`; `manual` keeps it out of `bazel test //...`.
    tags = ["manual"],
    deps = [":manifest"],
)

# Mirrors the checked-in manifest/component.textproto. The generated schema
# package is owned by the schema component and consumed through a declared
# component dependency.
# The protobuf runtime packages are declared members: third-party libraries
# become ordinary (checked) member code whose authority is charged to this
# component's declared_authority.
# EXEMPT (Step 6 task 05 AC8b; TODO(Step 7 protobuf-runtime PACKAGE_SURFACE
# migration): the transitional protobuf-runtime members reference UNANALYZED
# stdlib records — 102 AnalysisDefeating sites (same symbol set as
# artifactio: unsafe.Pointer x52, unsafe.Sizeof x5, unsafe.Slice x2,
# unsafe.SliceData x2, unsafe.String x2, unsafe.StringData x2,
# (sync.Once).Do x17, sort.Slice x11, (sync.Pool).Get x3,
# io.WriteString x2, io.ReadAll x2, compress/gzip.NewReader x1,
# errors.As x1) plus os.Open/os.Stderr findings (FILES x2,
# MODIFY_SYSTEM_STATE x1, OPERATING_SYSTEM x1) — so the checked .check test
# would fail its pass assertion. check_tags=["manual"] (the Step 5 task 05
# seam) keeps the analysis action built by `bazel build //...` while
# exempting the verdict test; Step 7 removes the exemption.
go_component(
    name = "manifest_component",
    check_tags = ["manual"],
    component_deps = ["//go/internal/schema:schema_component"],
    members = [
        "@org_golang_google_protobuf//encoding/prototext:prototext",
        "@org_golang_google_protobuf//encoding/protowire:protowire",
        "@org_golang_google_protobuf//internal/descfmt:descfmt",
        "@org_golang_google_protobuf//internal/descopts:descopts",
        "@org_golang_google_protobuf//internal/detrand:detrand",
        "@org_golang_google_protobuf//internal/editiondefaults:editiondefaults",
        "@org_golang_google_protobuf//internal/encoding/defval:defval",
        "@org_golang_google_protobuf//internal/encoding/messageset:messageset",
        "@org_golang_google_protobuf//internal/encoding/tag:tag",
        "@org_golang_google_protobuf//internal/encoding/text:text",
        "@org_golang_google_protobuf//internal/errors:errors",
        "@org_golang_google_protobuf//internal/filedesc:filedesc",
        "@org_golang_google_protobuf//internal/filetype:filetype",
        "@org_golang_google_protobuf//internal/flags:flags",
        "@org_golang_google_protobuf//internal/genid:genid",
        "@org_golang_google_protobuf//internal/impl:impl",
        "@org_golang_google_protobuf//internal/order:order",
        "@org_golang_google_protobuf//internal/pragma:pragma",
        "@org_golang_google_protobuf//internal/protolazy:protolazy",
        "@org_golang_google_protobuf//internal/set:set",
        "@org_golang_google_protobuf//internal/strs:strs",
        "@org_golang_google_protobuf//internal/version:version",
        "@org_golang_google_protobuf//proto:proto",
        "@org_golang_google_protobuf//reflect/protoreflect:protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry:protoregistry",
        "@org_golang_google_protobuf//runtime/protoiface:protoiface",
        "@org_golang_google_protobuf//runtime/protoimpl:protoimpl",
    ],
    declared_authority = [
        READ_SYSTEM_STATE,
        REFLECT,
        RUNTIME,
        SYSTEM_CALLS,
        UNSAFE_POINTER,
    ],
    interface = ":manifest",
    visibility = ["//go:__subpackages__"],
)
