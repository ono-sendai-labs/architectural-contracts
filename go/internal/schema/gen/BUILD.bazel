load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "gen",
    srcs = [
        "component.pb.go",
        "stdlibmap.pb.go",
        "surface.pb.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/schema/gen",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
    ],
)

# generated protoc-gen-go code uses unsafe.Slice/StringData and sync.Once; WARN keeps the 15 boilerplate sites visible without failing the gate; regenerate, never hand-edit.
go_component(
    name = "schema_gen_component",
    analysis_defeating_policy = "warn",
    component_deps = ["//go/internal/protobufruntime:protobuf-runtime"],
    interface = ":gen",
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
