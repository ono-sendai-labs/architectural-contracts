load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

exports_files([
    "capabilities.go",
    "component.textproto",
])

# The schema vocabulary package: the known Capslock capability taxonomy that
# the manifest model and the artifact-I/O shell consume through the schema
# component dependency.
go_library(
    name = "schema",
    srcs = ["capabilities.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/schema",
    # Like hostpolicy: the go_component rule resolves member labels from the
    # //bazel_rules rule packages, and the authority-sync shell test reads the
    # taxonomy source, so visibility must include //bazel_rules as well.
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
)

# Mirrors the checked-in schema/component.textproto: a package-surface
# component whose complete surface is the exported API of the generated
# protobuf package and the capability taxonomy package, so manifest and
# artifactio consume both through declared component dependencies instead of
# duplicated membership. The generated closure imports the shared protobuf
# runtime through its package-surface dependency. Its own generated-code
# analysis remains outside the default test wildcard because the current map
# deliberately reports its UNANALYZED constructs; consumers still validate
# the schema surface as an artifact dependency.
go_component(
    name = "schema_component",
    interface_style = "PACKAGE_SURFACE",
    component_deps = ["//go/internal/protobufruntime:protobuf-runtime"],
    members = [
        "//go/internal/schema",
        "//go/internal/schema/gen",
    ],
    # Its generated `.check` is excluded from `bazel test //...`
    # (`check_tags = ["manual"]`); the component itself stays checked
    # (Step 5 task 05 fixture migration: not an unowned component).
    check_tags = ["manual"],
    visibility = ["//go:__subpackages__"],
)
