load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")

exports_files(["component.textproto"])

# Mirrors the checked-in schema/component.textproto: the generated protobuf
# package is the component's declared interface, so manifest and artifactio
# consume the schema surface through declared component dependencies instead
# of duplicated membership. The generated closure imports the protobuf runtime
# owned by the consuming components' own member closures, so the component's
# own .check is kept out of the default test wildcard; the manifest is still
# validated every time a consumer resolves it as a dependency.
go_component(
    name = "schema_component",
    interface = "//go/internal/schema/gen",
    members = ["//go/internal/schema/gen"],
    tags = ["manual"],
    visibility = ["//go:__subpackages__"],
)
