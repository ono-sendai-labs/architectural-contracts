load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library")

exports_files([
    "capabilities.go",
    "component.textproto",
])

# The schema vocabulary package: the known Capslock capability taxonomy that
# the manifest model and the artifact-I/O shell consume through the schema
# component dependency. It is a declared member of the schema component
# alongside the generated package, but only the generated source forms the
# component's declared interface files.
go_library(
    name = "schema",
    srcs = ["capabilities.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/schema",
    # Like hostpolicy: the go_component rule resolves member labels from the
    # //bazel_rules rule packages, and the authority-sync shell test reads the
    # taxonomy source, so visibility must include //bazel_rules as well.
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
)

# Mirrors the checked-in schema/component.textproto: the generated protobuf
# package is the component's declared interface, so manifest and artifactio
# consume the schema surface through declared component dependencies instead
# of duplicated membership. The generated closure imports the protobuf runtime
# owned by the consuming components' own member closures, so the component's
# own .check is kept out of the default test wildcard; the manifest is still
# validated every time a consumer resolves it as a dependency.
go_component(
    name = "schema_component",
    interface = "//go/internal/schema/gen",
    members = [
        "//go/internal/schema",
        "//go/internal/schema/gen",
    ],
    tags = ["manual"],
    visibility = ["//go:__subpackages__"],
)
