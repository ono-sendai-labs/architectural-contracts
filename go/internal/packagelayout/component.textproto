name: "packagelayout"
# The package-layout loader defines its boundary across layout.go and api.go;
# goanalysis and stdlibmap consume this boundary.
interface_files: "layout.go"
interface_files: "api.go"
members: "github.com/ono-sendai-labs/architectural-contracts/go/internal/packagelayout"
component_dependencies {
  name: "packagelayout-hostenv"
  manifest: "./internal/hostenv/component.textproto"
}
component_dependencies {
  name: "x-tools"
  manifest: "../xtools/component.textproto"
}
# REFLECT and UNSAFE_POINTER come from `encoding/json` in the layout JSON
# codec and import-data descriptors (C9). The layout JSON codec and
# import-data descriptors are this component's own schema, so json.Marshal
# and json.Unmarshal are retained directly.
declared_authority: "REFLECT"
declared_authority: "UNSAFE_POINTER"
