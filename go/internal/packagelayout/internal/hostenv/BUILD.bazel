    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/packagelayout/internal/hostenv",
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
)

go_test(
    name = "hostenv_test",
    srcs = ["hostenv_test.go"],
    embed = [":hostenv"],
)

go_component(
    name = "hostenv_component",
    declared_authority = [
        MODIFY_SYSTEM_STATE,
        READ_SYSTEM_STATE,
        RUNTIME,
    ],
    interface_files = ["hostenv.go"],
    members = [":hostenv"],
    visibility = ["//go:__subpackages__"],
