load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packagelayout",
    srcs = ["buildtags.go", "ordinary_import_data.go", "packagelayout.go", "shape_imports.go", "stdlib_export_data.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/packagelayout",
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "//go/internal/packagelayout/internal/hostenv",
        "@org_golang_x_tools//go/packages",
    ],
)

go_test(
    name = "packagelayout_test",
    size = "small",
    srcs = [
        "buildtags_test.go",
        "dependency_artifacts_test.go",
        "driverhook_test.go",
        "export_data_test.go",
        "member_only_driver_test.go",
        "packagelayout_test.go",
    ],
    embed = [":packagelayout"],
    deps = [
        "//go/internal/hostpolicy",
        "@org_golang_x_tools//go/packages",
    ],
)

# Mirrors the checked-in packagelayout/component.textproto. The layout/driver
# package is one checked package-surface boundary shared by goanalysis and
# stdlibmap; x-tools remains the sole foreign closure boundary beneath it.
go_component(
    name = "packagelayout_component",
    interface_style = "PACKAGE_SURFACE",
    component_deps = [
        "//go/internal/packagelayout/internal/hostenv:hostenv_component",
        "//go/internal/xtools:x-tools",
    ],
    declared_authority = [
        "FILES",
        "READ_SYSTEM_STATE",
        "REFLECT",
        "UNSAFE_POINTER",
    ],
    members = ["//go/internal/packagelayout"],
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
