load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packagelayout",
    srcs = [
        "api.go",
        "buildtags.go",
        "driver.go",
        "layout.go",
        "ordinary_import_data.go",
        "scanner.go",
        "stdlib_export_data.go",
        "stdlibdiscover.go",
        "validate.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/packagelayout",
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "//go/internal/packagelayout/internal/hostenv",
        "@org_golang_x_tools//go/packages",
    ],
)

go_test(
    name = "packagelayout_test",
    size = "small",
    srcs = [
        "buildtags_test.go",
        "dependency_artifacts_test.go",
        "driverhook_test.go",
        "export_data_test.go",
        "member_only_driver_test.go",
        "packagelayout_test.go",
    ],
    embed = [":packagelayout"],
    deps = [
        "//go/internal/hostpolicy",
        "@org_golang_x_tools//go/packages",
    ],
)

# Mirrors the checked-in packagelayout/component.textproto. The layout/driver
# package defines its boundary across layout.go and api.go; goanalysis and
# stdlibmap consume this boundary.
go_component(
    name = "packagelayout_component",
    component_deps = [
        "//go/internal/packagelayout/internal/hostenv:hostenv_component",
        "//go/internal/xtools:x-tools",
    ],
    # REFLECT and UNSAFE_POINTER come from `encoding/json` in the layout JSON
    # codec and import-data descriptors (C9). The layout JSON codec and
    # import-data descriptors are this component's own schema, so json.Marshal
    # and json.Unmarshal are retained directly.
    declared_authority = [
        "REFLECT",
        "UNSAFE_POINTER",
    ],
    interface_files = [
        "layout.go",
        "api.go",
    ],
    members = ["//go/internal/packagelayout"],
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
