load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packagelayout",
    srcs = ["cgo_disabled.go", "cgo_enabled.go", "packagelayout.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/packagelayout",
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
    deps = [
        "@org_golang_x_tools//go/packages",
    ],
)

go_test(
    name = "packagelayout_test",
    size = "small",
    srcs = ["dependency_artifacts_test.go", "packagelayout_test.go"],
    embed = [":packagelayout"],
    deps = [
        "//go/internal/hostpolicy",
        "@org_golang_x_tools//go/packages",
    ],
)
