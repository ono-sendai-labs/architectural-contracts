load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "packagelayout",
    srcs = ["packagelayout.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/packagelayout",
# public: packagelayout is a declared member of the goanalysis component,
# whose go_component rule requires cross-package visibility for member labels.
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/hostpolicy",
        "@org_golang_x_tools//go/packages",
    ],
)

go_test(
    name = "packagelayout_test",
    size = "small",
    srcs = ["packagelayout_test.go"],
    embed = [":packagelayout"],
    deps = ["@org_golang_x_tools//go/packages"],
)
