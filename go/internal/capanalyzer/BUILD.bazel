load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "capanalyzer",
    srcs = ["capanalyzer.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/capanalyzer",
    visibility = ["//go:__subpackages__"],
)

go_test(
    name = "capanalyzer_test",
    size = "small",
    srcs = ["capanalyzer_test.go"],
    deps = [":capanalyzer"],
)

# Mirrors the checked-in capanalyzer/component.textproto.
go_component(
    name = "capanalyzer_component",
    interface = ":capanalyzer",
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
