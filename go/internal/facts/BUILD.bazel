load("@rules_arcc//bazel_rules/go:defs.bzl", "go_component")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "facts",
    srcs = [
        "bypass.go",
        "facts.go",
        "member.go",
        "refs.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/facts",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/capanalyzer",
        "//go/internal/manifest",
        "//go/internal/symbol",
    ],
)

go_test(
    name = "facts_test",
    size = "small",
    srcs = [
        "bypass_test.go",
        "facts_test.go",
        "member_test.go",
        "refs_test.go",
    ],
    deps = [
        ":facts",
        "//go/internal/capanalyzer",
        "//go/internal/hostpolicy",
        "//go/internal/manifest",
    ],
)

# Mirrors the checked-in facts/component.textproto.
go_component(
    name = "facts_component",
    component_deps = [
        "//go/internal/capanalyzer:capanalyzer_component",
        "//go/internal/manifest:manifest_component",
        "//go/internal/symbol:symbol_component",
    ],
    interface = ":facts",
    visibility = ["//go:__subpackages__"],
)

exports_files(["component.textproto"])
