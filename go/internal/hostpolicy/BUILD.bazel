load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "hostpolicy",
    srcs = ["hostpolicy.go"],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/internal/hostpolicy",
    # the go_component rule resolves member labels from the //bazel_rules rule
    # packages, so visibility must include those as well as in-tree consumers.
    visibility = [
        "//bazel_rules:__subpackages__",
        "//go:__subpackages__",
    ],
)

go_test(
    name = "hostpolicy_test",
    size = "small",
    srcs = ["hostpolicy_test.go", "namespace_test.go"],
    deps = [":hostpolicy"],
)
