load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "app",
    srcs = [
        "app.go",
        "check.go",
        "stdlibmap.go",
        "verdict.go",
    ],
    importpath = "github.com/ono-sendai-labs/architectural-contracts/go/cmd/arcc/app",
    visibility = ["//visibility:public"],
    deps = [
        "//go/internal/artifactio",
        "//go/internal/capanalyzer",
        "//go/internal/checker",
        "//go/internal/facts",
        "//go/internal/goanalysis",
        "//go/internal/hostpolicy",
        "//go/internal/manifest",
        "//go/internal/report",
        "//go/internal/schema/gen",
        "//go/internal/stdlibauthority",
        "//go/internal/stdlibmap",
        "//go/internal/surface",
        "//go/internal/symbol",
    ],
)

go_test(
    name = "app_test",
    size = "small",
    srcs = [
        "app_test.go",
        "check_internal_test.go",
        "check_test.go",
        "stdlibmap_test.go",
        "verdict_test.go",
    ],
    # keep: these tests drive the colocated (non-hermetic) loading path, which
    # shells out to `go list` and so needs a Go toolchain on PATH — the very
    # thing the Bazel rules exist to avoid. They run under `just ci`'s
    # `go test ./...`; `manual` keeps them out of `bazel test //...`.
    tags = ["manual"],
    deps = [
        ":app",
        "//go/internal/artifactio",
        "//go/internal/capanalyzer",
        "//go/internal/facts",
        "//go/internal/goanalysis",
        "//go/internal/report",
        "//go/internal/schema/gen",
        "//go/internal/stdlibauthority",
    ],
)

# gazelle:exclude self_manifest_parity_test.go
go_test(
    name = "self_manifest_parity_test",
    size = "small",
    srcs = ["self_manifest_parity_test.go"],
    args = [
        "$(rootpaths //go/internal/capanalyzer:capanalyzer_component)",
        "$(rootpaths //go/internal/report:report_component)",
        "$(rootpaths //go/internal/facts:facts_component)",
        "$(rootpaths //go/internal/manifest:manifest_component)",
        "$(rootpaths //go/internal/artifactio:artifactio_component)",
        "$(rootpaths //go/internal/schema:schema_component)",
        "$(rootpaths //go/internal/stdlibauthority:stdlibauthority_component)",
        "$(rootpaths //go/internal/checker:checker_component)",
        "$(rootpaths //go/internal/goanalysis:goanalysis_component)",
        "$(rootpaths //go/internal/protobufruntime:protobuf-runtime)",
        "$(rootpath //go/internal/capanalyzer:component.textproto)",
        "$(rootpath //go/internal/report:component.textproto)",
        "$(rootpath //go/internal/facts:component.textproto)",
        "$(rootpath //go/internal/manifest:component.textproto)",
        "$(rootpath //go/internal/artifactio:component.textproto)",
        "$(rootpath //go/internal/schema:component.textproto)",
        "$(rootpath //go/internal/stdlibauthority:component.textproto)",
        "$(rootpath //go/internal/checker:component.textproto)",
        "$(rootpath //go/internal/goanalysis:component.textproto)",
        "$(rootpath //go/internal/protobufruntime:component.textproto)",
    ],
    data = [
        "//go/internal/capanalyzer:capanalyzer_component",
        "//go/internal/capanalyzer:component.textproto",
        "//go/internal/checker:checker_component",
        "//go/internal/checker:component.textproto",
        "//go/internal/facts:facts_component",
        "//go/internal/facts:component.textproto",
        "//go/internal/goanalysis:component.textproto",
        "//go/internal/goanalysis:goanalysis_component",
        "//go/internal/protobufruntime:component.textproto",
        "//go/internal/protobufruntime:protobuf-runtime",
        "//go/internal/manifest:component.textproto",
        "//go/internal/manifest:manifest_component",
        "//go/internal/artifactio:artifactio_component",
        "//go/internal/artifactio:component.textproto",
        "//go/internal/schema:component.textproto",
        "//go/internal/schema:schema_component",
        "//go/internal/stdlibauthority:stdlibauthority_component",
        "//go/internal/stdlibauthority:component.textproto",
        "//go/internal/report:component.textproto",
        "//go/internal/report:report_component",
    ],
    deps = ["//go/internal/manifestparity"],
)
