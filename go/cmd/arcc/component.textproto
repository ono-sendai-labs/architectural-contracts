name: "cli"
# The native-only CLI spans the main package and its app orchestration package.
# Surface emission is package-scoped, so expose both concrete packages through
# one package-surface boundary instead of declaring interface files from two
# different type-checking units.
interface_style: INTERFACE_STYLE_PACKAGE_SURFACE
members: "github.com/ono-sendai-labs/architectural-contracts/go/cmd/arcc"
members: "github.com/ono-sendai-labs/architectural-contracts/go/cmd/arcc/app"
component_dependencies {
  name: "capanalyzer"
  manifest: "../../internal/capanalyzer/component.textproto"
}
component_dependencies {
  name: "checker"
  manifest: "../../internal/checker/component.textproto"
}
component_dependencies {
  name: "artifactio"
  manifest: "../../internal/artifactio/component.textproto"
}
component_dependencies {
  name: "facts"
  manifest: "../../internal/facts/component.textproto"
}
component_dependencies {
  name: "goanalysis"
  manifest: "../../internal/goanalysis/component.textproto"
}
component_dependencies {
  name: "manifest"
  manifest: "../../internal/manifest/component.textproto"
}
component_dependencies {
  name: "packagelayout"
  manifest: "../../internal/packagelayout/component.textproto"
}
component_dependencies {
  name: "report"
  manifest: "../../internal/report/component.textproto"
}
component_dependencies {
  name: "stdlibmap"
  manifest: "../../internal/stdlibmap/component.textproto"
}
component_dependencies {
  name: "stdlibauthority"
  manifest: "../../internal/stdlibauthority/component.textproto"
}
component_dependencies {
  name: "schema"
  manifest: "../../internal/schema/component.textproto"
}
component_dependencies {
  name: "surface"
  manifest: "../../internal/surface/component.textproto"
}

declared_authority: "FILES"
declared_authority: "OPERATING_SYSTEM"
declared_authority: "REFLECT"
declared_authority: "READ_SYSTEM_STATE"
declared_authority: "UNSAFE_POINTER"
declared_authority: "MODIFY_SYSTEM_STATE"
declared_authority: "EXEC"
