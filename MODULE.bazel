"""rules_arcc — Bazel rules for Architectural Contracts (arcc).

Consumers `bazel_dep` on this module to get the `arcc` binary (built from
source, version-matched with the rules) and, from Step 3 onward, the
`go_component` rule set under `//bazel_rules/go`.
"""

module(
    name = "rules_arcc",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Used only by the Bazel analysis fixture that proves target-platform
# extraction is independent of the execution SDK platform.
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)

# Analysis tests for the rules themselves; consumers never need it.
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

# Keep in sync with the `go` directive in go/go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.4")

# arcc's own dependencies (capslock, x/tools, protobuf) resolve from the same
# go.mod the non-Bazel build uses, so Bazel and `go build` never skew.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//go:go.mod")

# capslock ships a generated capability.pb.go; without this, Gazelle would
# build it from .proto via protoc, dragging a C++ toolchain into an otherwise
# pure-Go build.
go_deps.gazelle_override(
    directives = ["gazelle:proto disable_global"],
    path = "github.com/google/capslock",
)
use_repo(
    go_deps,
    "com_github_google_capslock",
    "org_golang_google_protobuf",
    "org_golang_x_tools",
)
